import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

// 8 Ignition Wires for V8
private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
}

// Flat-plane high-revving musical V8
// Fundamental pitch: 1 RPM = (RPM / 60) * 4 Hz
// 3,300 RPM = 220 Hz (A3 note)
// 6,600 RPM = 440 Hz (A4 concert pitch)
public node musical_v8 {
    alias output __out: engine;

    engine engine(
        name: "Musical Flat-Plane V8",
        starter_torque: 150 * units.lb_ft,
        starter_speed: 1200 * units.rpm,
        redline: 11000 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.95,
            burning_efficiency_randomness: 0.1
        ),
        hf_gain: 0.005,
        noise: 0.05,        // Kept low for clean musical timbre
        jitter: 0.05,       // Kept low for stable pitch
        simulation_frequency: 15000
    )

    wires wires()

    crankshaft c0(
        throw: 40 * units.mm / 2,
        flywheel_mass: 4.0 * units.lb,       // Light flywheel for fast transitions
        mass: 12.0 * units.lb,
        friction_torque: 4.0 * units.lb_ft,
        moment_of_inertia: 0.03,            // Low inertia = instantaneous response
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 4
    )

    rod_journal rj0(angle: 0.0)
    rod_journal rj1(angle: constants.pi)
    rod_journal rj2(angle: constants.pi)
    rod_journal rj3(angle: 0.0)

    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: 250 * units.g,
        compression_height: 1.0 * units.inch,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 250.0 * units.g,
        moment_of_inertia: 0.001,
        center_of_mass: 0.0,
        length: 5.5 * units.inch
    )

    cylinder_bank_parameters bank_params(
        bore: 85 * units.mm,
        deck_height: 8.0 * units.inch
    )

    intake intake(
        plenum_volume: 2.0 * units.L,
        plenum_cross_section_area: 25.0 * units.cm2,
        intake_flow_rate: k_carb(600.0),
        idle_flow_rate: k_carb(0.015),
        idle_throttle_plate_position: 0.988
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(600.0),
        primary_tube_length: 12.0 * units.inch,
        primary_flow_rate: k_carb(250.0),
        velocity_decay: 0.8,
        length: 80.0 * units.inch
    )

    exhaust_system exhaust0(es_params, audio_volume: 3.0, impulse_response: ir_lib.default_0)
    exhaust_system exhaust1(es_params, audio_volume: 3.0, impulse_response: ir_lib.default_0)

    cylinder_bank b0(bank_params, angle: -45.0 * units.deg)
    cylinder_bank b1(bank_params, angle: 45.0 * units.deg)

    b0
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj0, intake, exhaust0, wires.wire1)
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj1, intake, exhaust0, wires.wire2)
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj2, intake, exhaust0, wires.wire3)
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj3, intake, exhaust0, wires.wire4)

    b1
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj0, intake, exhaust1, wires.wire5)
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj1, intake, exhaust1, wires.wire6)
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj2, intake, exhaust1, wires.wire7)
        .add_cylinder(piston(piston_params), connecting_rod(cr_params), rj3, intake, exhaust1, wires.wire8)

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)
        .add_crankshaft(c0)

    harmonic_cam_lobe lobe(
        duration_at_50_thou: 240 * units.deg,
        gamma: 1.2,
        lift: 400 * units.thou,
        steps: 100
    )

    v8_camshaft_builder_crossplane camshaft(
        lobe_profile: lobe,
        lobe_separation: 110 * units.deg,
        base_radius: 500 * units.thou
    )

    b0.set_cylinder_head(
        generic_small_engine_head(
            chamber_volume: 55 * units.cc,
            intake_camshaft: camshaft.intake_cam_0,
            exhaust_camshaft: camshaft.exhaust_cam_0
        )
    )

    b1.set_cylinder_head(
        generic_small_engine_head(
            chamber_volume: 55 * units.cc,
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1,
            flip_display: true
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 18 * units.deg)
        .add_sample(2000 * units.rpm, 25 * units.deg)
        .add_sample(4000 * units.rpm, 32 * units.deg)
        .add_sample(6000 * units.rpm, 36 * units.deg)
        .add_sample(8000 * units.rpm, 38 * units.deg)
        .add_sample(10000 * units.rpm, 38 * units.deg)

    engine.add_ignition_module(
        v8_distributor(
            wires: wires,
            timing_curve: timing_curve,
            rev_limit: 10500 * units.rpm
        )
    )
}

public node main {
    set_engine(musical_v8())
    set_vehicle(vehicle(mass: 700 * units.kg))
    set_transmission(transmission())
}

main()
